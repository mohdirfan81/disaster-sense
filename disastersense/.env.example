# DisasterSense runtime configuration.
# Copy to `.env.local` and adjust as needed. All values have safe demo defaults,
# so the app runs with no configuration at all.

# Absolute public URL of the deployment. Used for metadata/canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo pacing: delay between agent pipeline steps so the UI shows progress.
# Set to 0 to run the pipeline with no artificial delay.
PIPELINE_STEP_DELAY_MS=650

# Demo pacing: gap between generated reports during a simulation batch.
SIMULATION_REPORT_GAP_MS=400
