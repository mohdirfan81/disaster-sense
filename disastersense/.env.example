# DisasterSense runtime configuration.
# Copy to `.env.local` and adjust as needed. All values have safe demo defaults,
# so the app runs with no configuration at all.

# Absolute public URL of the deployment. Used for metadata/canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo pacing: delay between agent pipeline steps so the UI shows progress.
# Set to 0 to run the pipeline with no artificial delay.
PIPELINE_STEP_DELAY_MS=650

# Demo pacing: gap between generated reports during a simulation batch.
SIMULATION_REPORT_GAP_MS=400

# ---------------------------------------------------------------------------
# Optional durable persistence (REQUIRED on serverless hosts like Vercel).
#
# The demo stores all state in an in-memory singleton that only survives inside
# a single long-running Node process. On serverless platforms each request can
# run in a different instance, so citizen reports would otherwise "disappear"
# from the Government / Rescue / Admin views.
#
# Connect a Vercel KV (Upstash Redis) store to the project and these variables
# are injected automatically. With them set, the app snapshots the whole dataset
# to one Redis key on every DB-backed request so all instances share one state.
# Leave them unset for local dev / tests / a single Render instance (no-op).
#
#   KV_REST_API_URL=https://<your-db>.upstash.io
#   KV_REST_API_TOKEN=<your-token>

